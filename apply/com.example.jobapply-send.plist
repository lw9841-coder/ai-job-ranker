<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.jobapply-send</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/ai-job-ranker/.apply/bin/python</string>
		<string>/path/to/ai-job-ranker/apply/apply.py</string>
		<string>--send</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/path/to/ai-job-ranker</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/path/to/home/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/path/to/ai-job-ranker/logs/apply.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/ai-job-ranker/logs/apply.log</string>
	<key>StartInterval</key>
	<integer>180</integer>
</dict>
</plist>
